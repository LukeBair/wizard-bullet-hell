#!/usr/bin/env bash
# Run a noisy command (Unity, xcodebuild, devicectl, Blender, TRELLIS, pip...) and show the AI
# only a short summary. The full output goes to Logs/quiet/<name>-<time>.log (gitignored).
#
#   tools/quiet/q [-n name] [-t tail_lines] [-g extra_grep_regex] -- command args...
#
# Prints: OK/FAIL, exit code, duration, log path, then any error/warning lines (deduped, capped)
# and, on failure, the last tail_lines lines. Exit code is the command's own.
set -uo pipefail

name="" tail_n=15 extra=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -n) name="$2"; shift 2 ;;
    -t) tail_n="$2"; shift 2 ;;
    -g) extra="$2"; shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
done
[[ $# -eq 0 ]] && { echo "usage: q [-n name] [-t tail] [-g regex] -- cmd args..." >&2; exit 2; }
[[ -z "$name" ]] && name="$(basename "$1")"

root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
mkdir -p "$root/Logs/quiet"
log="$root/Logs/quiet/${name}-$(date +%Y%m%d-%H%M%S).log"

start=$(date +%s)
"$@" >"$log" 2>&1 </dev/null
code=$?
secs=$(( $(date +%s) - start ))
lines=$(wc -l <"$log" | tr -d ' ')

if [[ $code -eq 0 ]]; then status=OK; else status=FAIL; fi
echo "$status $name (exit $code, ${secs}s, $lines log lines) log: $log"

# Error-ish lines from Unity, C#, IL2CPP, clang, xcodebuild, devicectl, Python and Blender.
pat='(error|Error|ERROR|exception|Exception|FAILED|fatal|Traceback|\*\* BUILD|BUILD FAILED|Compilation failed|CS[0-9]{4}|Build Finished, Result|Installed|App installed|Launched)'
[[ -n "$extra" ]] && pat="$pat|$extra"
hits=$(grep -E "$pat" "$log" \
  | grep -vE 'error(s)?: *0|0 error|warning CS|^\s*$|DisplayProgressbar|Refreshing native plugins' \
  | sed -E 's/[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9:.]+Z?//; s/[[:space:]]+/ /g' \
  | cut -c1-300 | awk '!seen[$0]++' | head -n 25)
if [[ -n "$hits" ]]; then
  echo "--- matched lines (first 25 unique) ---"
  echo "$hits"
fi

if [[ $code -ne 0 ]]; then
  echo "--- last $tail_n lines ---"
  tail -n "$tail_n" "$log" | cut -c1-300
fi
exit $code
